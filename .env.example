# No environment variables are required to run or build the app — the app only reads static
# assets at runtime (see public/*.geojson).
#
# The two variables below are only used locally, by scripts/generate-municipalities.mjs, to
# regenerate public/municipalities.geojson from Lantmäteriet's source data. They are build-time
# only and deliberately NOT prefixed with VITE_, so Vite never inlines them into the client
# bundle. See docs/DEPENDENCIES.md.
#
# Prefer an Application-scoped Consumer Key/Secret from Lantmäteriet's Geotorget devportal over
# a personal account login once you have devportal access — these should not be your personal
# account password long-term.
LANTMATERIET_USERNAME=
LANTMATERIET_PASSWORD=
